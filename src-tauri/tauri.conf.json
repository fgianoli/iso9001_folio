{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.2.0",
  "identifier": "it.federicogianoli.folio",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Folio", "width": 1180, "height": 860, "minWidth": 720, "minHeight": 560, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Codici, cartelle, clienti e archivio",
    "longDescription": "Registro delle commesse con codici univoci, cartelle standard, anagrafica clienti, riordino guidato e pulizia sicura. Sposta i file ma non li elimina; ogni operazione parte in simulazione e si può annullare.",
    "copyright": "© 2026 Federico Gianoli",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "linux": { "deb": { "depends": [] } }
  }
}
